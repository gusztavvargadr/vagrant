directory = File.dirname(__FILE__)

# ENV["VAGRANT_PROVIDER_CPUS"] = "8"
# ENV["VAGRANT_PROVIDER_MEMORY"] = "16384"
# ENV["VAGRANT_PROVIDER_NESTED_VIRTUALIZATION"] = "true"

load "#{directory}/../../src/core.Vagrantfile"

Vagrant.configure("2") do |config|
  config.vm.define "windows-latest", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-windows"

    config.vm.provision "shell", inline: <<-EOH
      cmd /c ver

      systeminfo
      Get-ComputerInfo

      Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
      choco list -i
    EOH
  end

  config.vm.define "windows-2025", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-windows-2025"

    config.vm.provision "shell", inline: <<-EOH
      cmd /c ver

      systeminfo
      Get-ComputerInfo

      Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
      choco list -i
    EOH
 end

  config.vm.define "windows-2022", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-windows-2022"

    config.vm.provision "shell", inline: <<-EOH
      cmd /c ver

      systeminfo
      Get-ComputerInfo

      Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
      choco list -i
    EOH
  end

  config.vm.define "ubuntu-latest", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-ubuntu"

    config.vm.provision "shell", inline: <<-EOH
      uname -a
      lsb_release -a

      lshw -short
      lscpu
      lsmem
    EOH
  end

  config.vm.define "ubuntu-2404", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-ubuntu-2404"

    config.vm.provision "shell", inline: <<-EOH
      uname -a
      lsb_release -a

      lshw -short
      lscpu
      lsmem
    EOH
  end

  config.vm.define "ubuntu-2204", autostart: false do |config|
    config.vm.box = "gusztavvargadr/development-ubuntu-2204"

    config.vm.provision "shell", inline: <<-EOH
      uname -a
      lsb_release -a

      lshw -short
      lscpu
      lsmem
    EOH
  end

  config.vm.provision "shell", inline: <<-EOH
    git --version

    dotnet --info
    dotnet tool list --global

    docker --version
  EOH
end
